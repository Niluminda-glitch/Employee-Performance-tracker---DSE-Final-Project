# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database_name
DB_PORT=5432

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Google OAuth
