# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=emptrack_db
DB_PORT=5432

# JWT Secret - This should be a long, random string in production
JWT_SECRET=emptrack_jwt_secret_key_for_development_only_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Server Port
PORT=5000
